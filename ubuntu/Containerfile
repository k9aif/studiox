# k9x_studio — Visual drag-and-drop K9-AIF builder
# Single container: FastAPI backend serves both the API and the built React
# frontend (backend/main.py mounts frontend/dist/ when present — no separate
# frontend container needed in production, only in local `run.sh` dev mode).
#
# Multi-stage build: Node stage builds the React/Vite frontend into
# frontend/dist/, then the Python stage copies backend + that dist/ output.
#
# Build context is this project's own directory -- everything this
# Containerfile copies comes from ${STUDIO_DIR} (this project itself,
# including its own k9x/_generator_templates/, scaffold_service.py's
# canonical BaseAgent/Squad/etc. templates). No sibling-repo checkout
# needed at build time. STUDIO_DIR still exists as a build-arg (defaults
# to "." — build-run.sh passes it explicitly) rather than this file
# hardcoding a path, since it's still useful if this project is ever built
# from a different context root.
#
# k9-aif itself installs from PyPI via requirements.txt (k9-aif[s3]) like
# every other dependency.
#
# Previously this Containerfile copied the generator templates from a
# sibling k9-aif-framework/generator/templates/ checkout instead -- a
# cross-repo dependency that broke when that directory was removed from
# the framework (2026-09-21, superseded by this project). Fixed to use
# the local copy that already existed here, removing the dependency and
# the multi-repo build context it required entirely, rather than
# restoring the deleted directory.
#
# Build (from this project's own directory):
#   podman build -t k9x-studio:latest \
#     --build-arg STUDIO_DIR=. \
#     -f ubuntu/Containerfile .
# (build-run.sh does this for you.)

ARG STUDIO_DIR=.

FROM docker.io/library/node:20-slim AS frontend-build
ARG STUDIO_DIR
WORKDIR /build/frontend
COPY ${STUDIO_DIR}/frontend/package.json ${STUDIO_DIR}/frontend/package-lock.json ./
RUN npm ci
COPY ${STUDIO_DIR}/frontend/ ./
RUN npm run build

FROM registry.access.redhat.com/ubi9/python-311:latest
ARG STUDIO_DIR
USER root

WORKDIR /app
COPY ${STUDIO_DIR}/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY ${STUDIO_DIR}/ .
COPY --from=frontend-build /build/frontend/dist /app/frontend/dist

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    K9X_GENERATOR_TEMPLATES_DIR=/app/k9x/_generator_templates

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=8s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8090/api/health')" \
      || exit 1

USER 1001

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8090", "--log-level", "info"]
