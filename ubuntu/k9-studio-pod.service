[Unit]
Description=k9x_studio — k9-studio-pod (1-container Podman pod)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Set this to wherever k9x_studio (aka "studiox") is actually cloned on
# this host before installing — see install-service.sh.
Environment=STUDIO_DEPLOY_DIR=/home/ravinata/ai/studiox

ExecStart=/usr/bin/podman play kube \
    ${STUDIO_DEPLOY_DIR}/ubuntu/studio-pod.yaml \
    --replace

ExecStop=/usr/bin/podman play kube \
    ${STUDIO_DEPLOY_DIR}/ubuntu/studio-pod.yaml \
    --down

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
