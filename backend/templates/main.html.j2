{# docs/main.html body — the fixed left-sidebar/top-bar/center-pane shell.
   Real Jinja2 template: {% for %} loops instead of a Python function
   building HTML strings, so this file can be opened and read like actual
   HTML. Traceability/Eval/Implementation section content arrives already
   rendered (from _traceability_content_html() etc.) and is inserted with
   `| safe` since Jinja2 auto-escapes by default. #}
<nav class="k9x-doc-nav">
  <div class="k9x-nav-header">
    <div class="k9x-nav-brand">K9X STUDIO</div>
    <div class="k9x-nav-title">{{ hero_title }}</div>
  </div>
  {% for sec_id, label, sub, _content in sections %}
  <a class="k9x-navlink{{ ' active' if loop.first else '' }}" href="#{{ sec_id }}">
    <span class="k9x-navlink-label">{{ label }}</span>
    {%- if sub %}<span class="k9x-navlink-sub">{{ sub }}</span>{% endif -%}
  </a>
  {% endfor %}
</nav>
<div class="k9x-doc-topbar">
  <span>⚡ Generated by K9X Studio on {{ timestamp }}</span>
  <a href="https://studiox.k9x.ai" target="_blank" rel="noopener" style="color:#8d8d93;">studiox.k9x.ai</a>
</div>
<div class="k9x-doc-main">
  {{ hero_html | safe }}
  <div class="k9x-doc-content">
    {% for sec_id, label, _sub, content in sections %}
    <section class="k9x-doc-section" id="{{ sec_id }}">
      <h2 style="color:#fff;font-size:18px;margin:0 0 14px;">{{ label }}</h2>
      {{ content | safe }}
    </section>
    {% endfor %}
  </div>
  <div class="k9x-footer">
    — End of document — · <b>K9X Studio generated document on {{ timestamp }}</b> ·
    <a href="https://studiox.k9x.ai">studiox.k9x.ai</a>
  </div>
</div>
<script>
{{ nav_highlight_js | safe }}
</script>
