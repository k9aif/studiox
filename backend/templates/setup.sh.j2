#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# {{ app_name }} — setup script generated by k9x_studio on {{ timestamp }}
#
# Usage:
#   ./setup.sh              interactive setup: venv, framework path, deps, .env
#   ./setup.sh --continue   resume after `source .venv/bin/activate`
#   ./setup.sh --verify     check the environment is ready, then exit
#
# This scaffold is self-contained — setup.sh and run.sh work directly from
# this folder, with no project-nesting layout from the canonical generator.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENV_FILE="$SCRIPT_DIR/.env"
FRAMEWORK_REPO_URL="{{ framework_repo_url }}"
PROJECT_IMPORT_CHECK='{{ project_import_stmt }}'
PROJECT_IMPORT_LABEL="{{ project_import_label }}"

MODE="${1:-}"

fail() { echo "ERROR: $*" >&2; exit 1; }
ok()   { echo "  [ok]   $*"; }
bad()  { echo "  [FAIL] $*"; }

# Resolve $1 to an absolute path. Relative paths are resolved against
# SCRIPT_DIR (the project root). ~ is expanded to $HOME.
resolve_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  case "$p" in
    /*) printf '%s\n' "$p" ;;
    *)  (cd "$SCRIPT_DIR/$p" 2>/dev/null && pwd) || printf '%s/%s\n' "$SCRIPT_DIR" "$p" ;;
  esac
}

# ---------------------------------------------------------------------------
# --verify: check the environment is ready, then exit
# ---------------------------------------------------------------------------
run_verify() {
  local failed=0
  local fw_abs=""

  echo "=== {{ app_name }} — setup verification ==="
  echo

  echo "Python:"
  if command -v python3 >/dev/null 2>&1; then
    ok "python3 -> $(command -v python3) ($(python3 --version 2>&1))"
  else
    bad "python3 not found on PATH"
    failed=1
  fi

  echo
  echo "Virtual environment:"
  if [ -n "${VIRTUAL_ENV:-}" ]; then
    ok "active venv: $VIRTUAL_ENV"
  else
    bad "no virtual environment active — run: source .venv/bin/activate"
    failed=1
  fi

  echo
  echo ".env:"
  if [ -f "$ENV_FILE" ]; then
    ok "$ENV_FILE exists"
    set -a
    # shellcheck disable=SC1090,SC1091
    source "$ENV_FILE"
    set +a
  else
    bad "$ENV_FILE not found"
    failed=1
  fi

  echo
  echo "K9_FRAMEWORK_PATH:"
  if [ -z "${K9_FRAMEWORK_PATH:-}" ]; then
    bad "K9_FRAMEWORK_PATH not set in .env"
    failed=1
  else
    fw_abs="$(resolve_path "$K9_FRAMEWORK_PATH")"
    if [ -d "$fw_abs/k9_aif_abb" ]; then
      ok "K9_FRAMEWORK_PATH -> $fw_abs (k9_aif_abb/ found)"
    else
      bad "K9_FRAMEWORK_PATH ($fw_abs) does not contain k9_aif_abb/"
      failed=1
    fi
  fi

  echo
  echo "Imports:"
  if [ -n "${VIRTUAL_ENV:-}" ] && [ -n "$fw_abs" ] && [ -d "$fw_abs/k9_aif_abb" ]; then
    export PYTHONPATH="$SCRIPT_DIR:$fw_abs${PYTHONPATH:+:$PYTHONPATH}"
    if python3 -c "import k9_aif_abb" >/dev/null 2>&1; then
      ok "import k9_aif_abb"
    else
      bad "import k9_aif_abb failed — check $fw_abs/requirements.txt is installed"
      failed=1
    fi

    if python3 -c "$PROJECT_IMPORT_CHECK" >/dev/null 2>&1; then
      ok "$PROJECT_IMPORT_LABEL"
    else
      bad "$PROJECT_IMPORT_LABEL failed"
      failed=1
    fi
  else
    echo "  [skip] fix the venv / K9_FRAMEWORK_PATH checks above first"
    failed=1
  fi

  echo
  if [ "$failed" -eq 0 ]; then
    echo "setup was success"
    echo
    echo "Tip: see README.md -> 'Prerequisites' for the Ollama models this"
    echo "     project needs (ollama pull ...) before running ./run.sh."
    echo
    echo "Ready to rumble!"
    return 0
  fi
  echo "Some checks failed — see [FAIL] lines above."
  return 1
}

if [ "$MODE" = "--verify" ]; then
  run_verify
  exit $?
fi

echo "=== {{ app_name }} — setup ==="
echo

# ---------------------------------------------------------------------------
# A. Virtual environment
# ---------------------------------------------------------------------------
if [ -z "${VIRTUAL_ENV:-}" ]; then
  if [ "$MODE" = "--continue" ]; then
    fail "no virtual environment active. Run: source .venv/bin/activate && ./setup.sh --continue"
  fi

  echo "No active Python virtual environment detected."
  echo
  echo "  1) I already have a venv — I'll activate it myself, then re-run ./setup.sh"
  echo "  2) Create a .venv/ here for me"
  echo
  read -rp "Choose [1/2]: " venv_choice

  if [ "$venv_choice" = "2" ]; then
    PYBIN=""
    for cand in python3.12 python3.11; do
      if command -v "$cand" >/dev/null 2>&1; then
        PYBIN="$cand"
        break
      fi
    done
    if [ -z "$PYBIN" ] && command -v python3 >/dev/null 2>&1; then
      PYVER="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
      case "$PYVER" in
        3.14|3.15|3.16|3.17|3.18|3.19)
          echo "WARNING: only python3 ($PYVER) was found — venv/ensurepip may fail on this version."
          echo "  Install python3.12 or python3.11 for best results."
          ;;
      esac
      PYBIN="python3"
    fi
    [ -n "$PYBIN" ] || fail "no python3 interpreter found on PATH"

    echo "Creating .venv/ with $PYBIN ..."
    "$PYBIN" -m venv "$SCRIPT_DIR/.venv"
    echo
    echo "Virtual environment created at .venv/"
    echo "Now run:"
    echo
    echo "    source .venv/bin/activate && ./setup.sh --continue"
    echo
    exit 0
  fi

  echo
  echo "OK — activate your venv, then re-run:"
  echo
  echo "    source <your-venv>/bin/activate && ./setup.sh --continue"
  echo
  exit 0
fi

ok "Virtual environment active: $VIRTUAL_ENV"

# ---------------------------------------------------------------------------
# B. Framework path
# ---------------------------------------------------------------------------
echo
echo "=== Framework setup ==="
echo
echo "Recommended workspace layout:"
echo "  workspace/"
echo "    {{ app_folder }}/        (this project)"
echo "    k9-aif-framework/  (sibling clone)"
echo
echo "  1) Use an existing k9-aif-framework folder"
echo "  2) Clone k9-aif-framework into ../k9-aif-framework"
echo
read -rp "Choose [1/2]: " fw_choice

FW_JUST_CLONED=""
case "$fw_choice" in
  1)
    read -rp "Path to your k9-aif-framework folder (absolute or relative): " fw_input
    FW_PATH="$(resolve_path "$fw_input")"
    [ -d "$FW_PATH/k9_aif_abb" ] || fail "$FW_PATH does not contain k9_aif_abb/ — not a k9-aif-framework checkout"
    FW_ENV_VALUE="$FW_PATH"
    ;;
  2)
    FW_PATH="$(cd "$SCRIPT_DIR/.." && pwd)/k9-aif-framework"
    if [ -d "$FW_PATH/k9_aif_abb" ]; then
      ok "found existing $FW_PATH"
    else
      echo "Cloning k9-aif-framework into $FW_PATH ..."
      git clone "$FRAMEWORK_REPO_URL" "$FW_PATH"
      FW_JUST_CLONED=1
    fi
    FW_ENV_VALUE="../k9-aif-framework"
    ;;
  *)
    fail "invalid choice: $fw_choice"
    ;;
esac
ok "framework path: $FW_PATH"

# Offer to update an existing checkout to the latest. Skip if we just
# cloned it (already at HEAD) or if it's not a git checkout at all.
if [ -z "$FW_JUST_CLONED" ] && [ -d "$FW_PATH/.git" ]; then
  read -rp "Update framework checkout with 'git pull'? [y/N]: " fw_update
  case "$fw_update" in
    y|Y)
      if git -C "$FW_PATH" diff --quiet 2>/dev/null && git -C "$FW_PATH" diff --cached --quiet 2>/dev/null; then
        echo "Pulling latest framework updates..."
        git -C "$FW_PATH" pull || echo "WARNING: git pull failed — continuing with existing checkout."
      else
        echo "WARNING: $FW_PATH has local changes — skipping git pull to avoid conflicts."
      fi
      ;;
  esac
fi

# ---------------------------------------------------------------------------
# C. Install dependencies
# ---------------------------------------------------------------------------
echo
echo "=== Installing dependencies ==="
python3 -m pip install --upgrade pip setuptools wheel

if [ -f "$SCRIPT_DIR/requirements.txt" ]; then
  echo "Installing project requirements..."
  python3 -m pip install -r "$SCRIPT_DIR/requirements.txt"
fi

if [ -f "$FW_PATH/requirements.txt" ]; then
  echo "Installing framework requirements (this may take a while)..."
  python3 -m pip install -r "$FW_PATH/requirements.txt"
fi

# ---------------------------------------------------------------------------
# D. Update .env (K9_ENV, K9_FRAMEWORK_PATH) without duplicating keys
# ---------------------------------------------------------------------------
echo
echo "=== Updating .env ==="

set_env_var() {
  local key="$1" value="$2" tmp="$ENV_FILE.tmp.$$" found=0
  : > "$tmp"
  if [ -f "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        "$key="*|"# $key="*|"#$key="*)
          if [ "$found" -eq 0 ]; then
            printf '%s="%s"\n' "$key" "$value" >> "$tmp"
            found=1
          fi
          ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$ENV_FILE"
  fi
  if [ "$found" -eq 0 ]; then
    printf '%s="%s"\n' "$key" "$value" >> "$tmp"
  fi
  mv "$tmp" "$ENV_FILE"
}

set_env_var "K9_ENV" "development"
set_env_var "K9_FRAMEWORK_PATH" "$FW_ENV_VALUE"
ok ".env updated (K9_ENV=development, K9_FRAMEWORK_PATH=$FW_ENV_VALUE)"

# ---------------------------------------------------------------------------
# E. Validate imports
# ---------------------------------------------------------------------------
echo
echo "=== Validating imports ==="

export PYTHONPATH="$SCRIPT_DIR:$FW_PATH${PYTHONPATH:+:$PYTHONPATH}"

python3 -c "import k9_aif_abb" \
  && ok "import k9_aif_abb" \
  || fail "import k9_aif_abb failed — check $FW_PATH/requirements.txt is installed"

python3 -c "$PROJECT_IMPORT_CHECK" \
  && ok "$PROJECT_IMPORT_LABEL" \
  || fail "$PROJECT_IMPORT_LABEL failed"

echo
echo "setup was success"
echo
echo "Next steps:"
echo "  source .venv/bin/activate   # if not already active"
echo "  ./run.sh"
echo
echo "Tip: see README.md -> 'Prerequisites' for the Ollama models this"
echo "     project needs (ollama pull ...) before running ./run.sh."
echo
echo "Ready to rumble!"
