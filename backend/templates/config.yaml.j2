# Generated by k9x_studio on {{ timestamp }}

app:
  name: "{{ app_name }}"
  folder: "{{ app_folder }}"
  author: "{{ author }}"
  domain: "{{ domain }}"

# ── Selected platforms & infrastructure ────────────────────────────────────
# Mirrors the checkboxes selected in k9x_studio's left pane (Platforms &
# Frameworks). This is declarative only — nothing here is wired up yet.
# It is up to the SBB to extend the relevant K9-AIF base classes (see
# context/k9_aif_abb) and implement these integrations as needed.
platforms:
  agent_frameworks: {{ agent_frameworks | tojson }}
  ibm_watsonx: {{ ibm_watsonx | tojson }}
  messaging: {{ messaging | tojson }}
  databases: {{ databases | tojson }}
  deployment_targets: {{ deployment_targets | tojson }}

# ── Inference backend ────────────────────────────────────────────────────────
# K9-AIF supports pluggable LLM providers via ProviderAdapterRegistry.
# Switch provider by editing the llm_factory block below — no code changes needed.
#
# API keys belong in .env (or environment variables), NOT in this file.
# Use api_key_env: MY_ENV_VAR_NAME to reference them safely.
# ─────────────────────────────────────────────────────────────────────────────

inference:
  llm_factory:

    # ── Ollama (default — local, no API key needed) ───────────────────────
    backend: ollama
    provider: ollama
    base_url: "${OLLAMA_BASE_URL:-http://localhost:11434}"
    models:
      # Model tags come from .env (K9_MODEL_GENERAL / K9_MODEL_REASONING);
      # the small defaults below run anywhere. See .env.example.
      general:
        model: "${K9_MODEL_GENERAL:-llama3.2:1b}"
        temperature: 0.3
        max_tokens: 2048
      reasoning:
        model: "${K9_MODEL_REASONING:-granite3-dense:2b}"
        temperature: 0.2
        max_tokens: 4096

    # ── OpenAI ───────────────────────────────────────────────────────────
    # To enable: comment out the Ollama block above and uncomment this block.
    # Set OPENAI_API_KEY in your .env file.
    #
    # backend: openai
    # provider: openai
    # api_key_env: OPENAI_API_KEY          # key resolved from environment — never hardcode
    # models:
    #   general:
    #     model: "gpt-4o-mini"
    #     temperature: 0.3
    #     max_tokens: 2048
    #   reasoning:
    #     model: "gpt-4o"
    #     temperature: 0.2
    #     max_tokens: 4096

    # ── Grok / xAI (OpenAI-compatible) ───────────────────────────────────
    # To enable: comment out the Ollama block above and uncomment this block.
    # Set GROK_API_KEY in your .env file.
    #
    # backend: openai-compatible
    # provider: grok
    # base_url: "https://api.x.ai/v1"
    # api_key_env: GROK_API_KEY             # key resolved from environment — never hardcode
    # models:
    #   general:
    #     model: "grok-3-mini"
    #     temperature: 0.3
    #     max_tokens: 2048
    #   reasoning:
    #     model: "grok-3"
    #     temperature: 0.2
    #     max_tokens: 4096

    # ── Custom / future provider ──────────────────────────────────────────
    # Register any BaseProviderAdapter subclass before bootstrap:
    #   ProviderAdapterRegistry.register("myprovider", MyProviderAdapter)
    # Then set backend: myprovider here.

  router:
    type: k9_model_router
    default_model: general
    persistence:
      enabled: true
      provider: sqlite  # switch to "postgres" + uncomment the postgres: block below to use Postgres

  model_catalog:
    default_model: general
    models:
      general:
        provider: ollama
        llm_ref: general
        capabilities: [general, chat, summarization]
        latency_tier: realtime
        cost_tier: minimal
      reasoning:
        provider: ollama
        llm_ref: reasoning
        capabilities: [reasoning, analysis, extraction]
        latency_tier: interactive
        cost_tier: standard

# Every generated agent's __init__ wires k9x_Shield in by default (see
# security.shield below). Granite Guardian is standard too: a semantic LLM
# screen added on top of Shield (additive, never a replacement). It calls
# Ollama directly with the model below. Pull it first:
#   ollama pull granite4.1-guardian:8b
# fail_closed blocks an agent call when Guardian is unreachable; set
# K9_GUARDIAN_ENABLED=false in .env to turn it off.
governance:
  enabled: false
  guardian:
    enabled: "${K9_GUARDIAN_ENABLED:-true}"
    model: "${K9_GUARDIAN_MODEL:-granite4.1-guardian:8b}"
    on_unavailable: "${K9_GUARDIAN_ON_UNAVAILABLE:-fail_closed}"

# ── k9x_Shield — Chain of Vulnerability Tests ────────────────────────────────
# Wired into every generated agent by default (see agents/*.py's __init__) —
# not just documented here. Dual-gate: ingress chain runs before the LLM,
# egress chain runs after the LLM and before any tool executes. All 13
# checks run both directions by default; narrow this list, or set
# enabled: false, to reduce coverage for this deployment. strict: true
# promotes FLAG → BLOCK. Per-check tuning (thresholds, block_on_match: false
# to downgrade a specific check to FLAG-only): check_config below.
security:
  shield:
    enabled: true
    strict: false
    ingress:
      checks:
        - InputSizeCheck
        - PromptInjectionCheck
        - PIIBoundaryCheck
        - SemanticDriftCheck
        - ToolArgumentCheck
        - ExecutionGuardCheck
        - HardcodedCredentialCheck
        - ToolAuthorizationCheck
        - MemoryPoisoningCheck
        - SystemPromptLeakageCheck
        - OutputSanitizationCheck
        - RequestFrequencyCheck
        - PIIRequestCheck
    egress:
      checks:
        - InputSizeCheck
        - PromptInjectionCheck
        - PIIBoundaryCheck
        - SemanticDriftCheck
        - ToolArgumentCheck
        - ExecutionGuardCheck
        - HardcodedCredentialCheck
        - ToolAuthorizationCheck
        - MemoryPoisoningCheck
        - SystemPromptLeakageCheck
        - OutputSanitizationCheck
        - RequestFrequencyCheck
        - PIIRequestCheck

monitoring:
  console: true
  log_level: INFO

logging:
  level: DEBUG

# ── Object Storage ────────────────────────────────────────────────────────
# The Router stores inbound documents in the object store before publishing
# the event to Kafka — only the URI appears in the message, never the bytes.
# Downstream agents retrieve by URI via ObjectStorageFactory.
#
# Credentials belong in .env (or environment variables), NOT in this file.
{% if object_storage and 'S3 / MinIO' in object_storage %}
object_storage:
  enabled: true
  provider: s3
  s3:
    provider: "minio"                                          # minio | aws
    bucket: "{{ app_folder }}-documents"
    endpoint_url: "${S3_ENDPOINT_URL:-http://localhost:9000}"   # MinIO local
    # endpoint_url: "http://host.docker.internal:9000"         # use from Docker
    access_key: "${S3_ACCESS_KEY}"                             # set in .env
    secret_key: "${S3_SECRET_KEY}"                             # set in .env
    region: "${S3_REGION:-us-east-1}"
    secure: false                                              # true for HTTPS
{% elif object_storage and 'IBM Cloud Object Storage' in object_storage %}
object_storage:
  enabled: true
  provider: ibm
  ibm:
    bucket: "{{ app_folder }}-documents"
    endpoint_url: "${IBM_COS_ENDPOINT}"
    region: "${IBM_COS_REGION:-us-south}"
    api_key: "${IBM_COS_API_KEY}"                              # set in .env
    instance_crn: "${IBM_COS_INSTANCE_CRN}"                    # set in .env
{% elif object_storage and 'Local Filesystem' in object_storage %}
object_storage:
  enabled: true
  provider: local
  root: "./object_store"
{% else %}
# object_storage:
#   enabled: true
#   provider: s3                                               # local | s3 | ibm
#   s3:
#     provider: "minio"                                        # minio | aws
#     bucket: "{{ app_folder }}-documents"
#     endpoint_url: "${S3_ENDPOINT_URL:-http://localhost:9000}"
#     access_key: "${S3_ACCESS_KEY}"                           # set in .env
#     secret_key: "${S3_SECRET_KEY}"                           # set in .env
#     region: "${S3_REGION:-us-east-1}"
#     secure: false
{% endif %}

# ── Docling / OCR ─────────────────────────────────────────────────────────
# Converts uploaded documents (PDF, DOCX, images) to clean Markdown before
# agents process them.  The Router fetches the original file from S3, sends
# it to the Docling server, and stores the normalized .md output back to
# a dedicated S3 bucket.  Agents receive only the markdown — never raw binary.
#
# Flow:
#   1. User uploads document → app_backend → Router
#   2. Router stores original in S3 (object_storage above)
#   3. Router sends original to Docling server → receives .md
#   4. Router stores .md in docling_bucket
#   5. Router publishes event with document_uri pointing to .md in docling_bucket
#   6. Downstream agents read clean markdown from S3
{% if docling_enabled %}
docling:
  enabled: true
  endpoint: "${DOCLING_ENDPOINT:-http://localhost:5001/v1/parse}"
  docling_bucket: "{{ app_folder }}-docling-out"               # S3 bucket for normalized .md output
{% else %}
# docling:
#   enabled: true
#   endpoint: "${DOCLING_ENDPOINT:-http://localhost:5001/v1/parse}"
#   docling_bucket: "{{ app_folder }}-docling-out"
{% endif %}

