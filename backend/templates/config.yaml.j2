# Generated by k9x_studio on {{ timestamp }}

app:
  name: "{{ app_name }}"
  folder: "{{ app_folder }}"
  author: "{{ author }}"
  domain: "{{ domain }}"

# ── Selected platforms & infrastructure ────────────────────────────────────
# Mirrors the checkboxes selected in k9x_studio's left pane (Platforms &
# Frameworks). This is declarative only — nothing here is wired up yet.
# It is up to the SBB to extend the relevant K9-AIF base classes (see
# context/k9_aif_abb) and implement these integrations as needed.
platforms:
  agent_frameworks: {{ agent_frameworks | tojson }}
  ibm_watsonx: {{ ibm_watsonx | tojson }}
  messaging: {{ messaging | tojson }}
  databases: {{ databases | tojson }}
  deployment_targets: {{ deployment_targets | tojson }}

# ── Inference backend ────────────────────────────────────────────────────────
# K9-AIF supports pluggable LLM providers via ProviderAdapterRegistry.
# Switch provider by editing the llm_factory block below — no code changes needed.
#
# API keys belong in .env (or environment variables), NOT in this file.
# Use api_key_env: MY_ENV_VAR_NAME to reference them safely.
# ─────────────────────────────────────────────────────────────────────────────

inference:
  llm_factory:

    # ── Ollama (default — local, no API key needed) ───────────────────────
    backend: ollama
    provider: ollama
    base_url: "{{ ollama_base_url }}"
    models:
      general:
        model: "llama3.2:1b"
        temperature: 0.3
        max_tokens: 2048
      reasoning:
        model: "granite3-dense:2b"
        temperature: 0.2
        max_tokens: 4096

    # ── OpenAI ───────────────────────────────────────────────────────────
    # To enable: comment out the Ollama block above and uncomment this block.
    # Set OPENAI_API_KEY in your .env file.
    #
    # backend: openai
    # provider: openai
    # api_key_env: OPENAI_API_KEY          # key resolved from environment — never hardcode
    # models:
    #   general:
    #     model: "gpt-4o-mini"
    #     temperature: 0.3
    #     max_tokens: 2048
    #   reasoning:
    #     model: "gpt-4o"
    #     temperature: 0.2
    #     max_tokens: 4096

    # ── Grok / xAI (OpenAI-compatible) ───────────────────────────────────
    # To enable: comment out the Ollama block above and uncomment this block.
    # Set GROK_API_KEY in your .env file.
    #
    # backend: openai-compatible
    # provider: grok
    # base_url: "https://api.x.ai/v1"
    # api_key_env: GROK_API_KEY             # key resolved from environment — never hardcode
    # models:
    #   general:
    #     model: "grok-3-mini"
    #     temperature: 0.3
    #     max_tokens: 2048
    #   reasoning:
    #     model: "grok-3"
    #     temperature: 0.2
    #     max_tokens: 4096

    # ── Custom / future provider ──────────────────────────────────────────
    # Register any BaseProviderAdapter subclass before bootstrap:
    #   ProviderAdapterRegistry.register("myprovider", MyProviderAdapter)
    # Then set backend: myprovider here.

  router:
    type: k9_model_router
    default_model: general
    persistence:
      enabled: true
      provider: sqlite  # switch to "postgres" + uncomment the postgres: block below to use Postgres

  model_catalog:
    default_model: general
    models:
      general:
        provider: ollama
        llm_ref: general
        capabilities: [general, chat, summarization]
        latency_tier: realtime
        cost_tier: minimal
      reasoning:
        provider: ollama
        llm_ref: reasoning
        capabilities: [reasoning, analysis, extraction]
        latency_tier: interactive
        cost_tier: standard

governance:
  enabled: false

monitoring:
  console: true
  log_level: INFO

logging:
  level: DEBUG

# ── Object Storage ────────────────────────────────────────────────────────
# The Router stores inbound documents in the object store before publishing
# the event to Kafka — only the URI appears in the message, never the bytes.
# Downstream agents retrieve by URI via ObjectStorageFactory.
#
# Credentials belong in .env (or environment variables), NOT in this file.
{% if object_storage and 'S3 / MinIO' in object_storage %}
object_storage:
  enabled: true
  provider: s3
  s3:
    provider: "minio"                                          # minio | aws
    bucket: "{{ app_folder }}-documents"
    endpoint_url: "${S3_ENDPOINT_URL:-http://localhost:9000}"   # MinIO local
    # endpoint_url: "http://host.docker.internal:9000"         # use from Docker
    access_key: "${S3_ACCESS_KEY}"                             # set in .env
    secret_key: "${S3_SECRET_KEY}"                             # set in .env
    region: "${S3_REGION:-us-east-1}"
    secure: false                                              # true for HTTPS
{% elif object_storage and 'IBM Cloud Object Storage' in object_storage %}
object_storage:
  enabled: true
  provider: ibm
  ibm:
    bucket: "{{ app_folder }}-documents"
    endpoint_url: "${IBM_COS_ENDPOINT}"
    region: "${IBM_COS_REGION:-us-south}"
    api_key: "${IBM_COS_API_KEY}"                              # set in .env
    instance_crn: "${IBM_COS_INSTANCE_CRN}"                    # set in .env
{% elif object_storage and 'Local Filesystem' in object_storage %}
object_storage:
  enabled: true
  provider: local
  root: "./object_store"
{% else %}
# object_storage:
#   enabled: true
#   provider: s3                                               # local | s3 | ibm
#   s3:
#     provider: "minio"                                        # minio | aws
#     bucket: "{{ app_folder }}-documents"
#     endpoint_url: "${S3_ENDPOINT_URL:-http://localhost:9000}"
#     access_key: "${S3_ACCESS_KEY}"                           # set in .env
#     secret_key: "${S3_SECRET_KEY}"                           # set in .env
#     region: "${S3_REGION:-us-east-1}"
#     secure: false
{% endif %}

