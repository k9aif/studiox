#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# {{ app_name }} — run script generated by k9x_studio on {{ timestamp }}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PROJECT_IMPORT_CHECK='{{ project_import_stmt }}'

if [ -z "${VIRTUAL_ENV:-}" ]; then
  echo "No active Python virtual environment detected." >&2
  echo "  Run ./setup.sh first to configure the project, then:" >&2
  echo "    source .venv/bin/activate   # or your own venv" >&2
  echo "    ./run.sh" >&2
  exit 1
fi

if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.env"
  set +a
fi

if [ -z "${K9_FRAMEWORK_PATH:-}" ]; then
  echo "ERROR: K9_FRAMEWORK_PATH not set in .env." >&2
  echo "  Run ./setup.sh to configure it, or edit .env directly." >&2
  exit 1
fi

# Expand ~ and resolve relative to the project root (this folder)
K9_FRAMEWORK_PATH="${K9_FRAMEWORK_PATH/#\~/$HOME}"
case "$K9_FRAMEWORK_PATH" in
  /*) : ;;
  *) K9_FRAMEWORK_PATH="$SCRIPT_DIR/$K9_FRAMEWORK_PATH" ;;
esac
K9_FRAMEWORK_PATH="$(cd "$K9_FRAMEWORK_PATH" 2>/dev/null && pwd || echo "$K9_FRAMEWORK_PATH")"

if [ ! -d "$K9_FRAMEWORK_PATH/k9_aif_abb" ]; then
  echo "ERROR: K9_FRAMEWORK_PATH ($K9_FRAMEWORK_PATH) does not contain k9_aif_abb/." >&2
  echo "  Run ./setup.sh to clone or point at a valid k9-aif-framework checkout." >&2
  exit 1
fi

# Project root (this folder) + framework path on PYTHONPATH.
# Self-contained scaffold — no project-nesting layout required.
export PYTHONPATH="$SCRIPT_DIR:$K9_FRAMEWORK_PATH${PYTHONPATH:+:$PYTHONPATH}"
# Development mode — skips the governance pipeline for local runs
export K9_ENV="${K9_ENV:-development}"

echo "=== {{ app_name }} ({{ app_folder }}) ==="
echo "  Python:            $(command -v python3) ($(python3 --version 2>&1))"
echo "  Project root:      $SCRIPT_DIR"
echo "  K9_FRAMEWORK_PATH:  $K9_FRAMEWORK_PATH"
echo "  PYTHONPATH:         $PYTHONPATH"
echo "  K9_ENV:             $K9_ENV"
echo

python3 -c "import k9_aif_abb" >/dev/null 2>&1 || {
  echo "ERROR: 'import k9_aif_abb' failed." >&2
  echo "  Check K9_FRAMEWORK_PATH and run:" >&2
  echo "    pip install -r \"$K9_FRAMEWORK_PATH/requirements.txt\"" >&2
  exit 1
}

python3 -c "$PROJECT_IMPORT_CHECK" >/dev/null 2>&1 || {
  echo "ERROR: project-local imports failed ({{ project_import_label }})." >&2
  echo "  Run ./setup.sh --verify for details." >&2
  exit 1
}

python3 "$SCRIPT_DIR/main.py" "$@"
