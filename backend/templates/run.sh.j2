#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# {{ app_name }} — run script generated by k9x_studio on {{ timestamp }}

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PROJECT_IMPORT_CHECK='{{ project_import_stmt }}'

if [ -z "${VIRTUAL_ENV:-}" ]; then
  echo "No active Python virtual environment detected." >&2
  echo "  Run ./setup.sh first to configure the project, then:" >&2
  echo "    source .venv/bin/activate   # or your own venv" >&2
  echo "    ./run.sh" >&2
  exit 1
fi

if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.env"
  set +a
fi

# Project root (this folder) on PYTHONPATH — k9_aif_abb itself comes from
# PyPI (see requirements.txt), already on this venv's sys.path via pip.
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
# Development mode — skips the governance pipeline for local runs
export K9_ENV="${K9_ENV:-development}"

echo "=== {{ app_name }} ({{ app_folder }}) ==="
echo "  Python:            $(command -v python3) ($(python3 --version 2>&1))"
echo "  Project root:      $SCRIPT_DIR"
echo "  PYTHONPATH:        $PYTHONPATH"
echo "  K9_ENV:            $K9_ENV"
echo

python3 -c "import k9_aif_abb" >/dev/null 2>&1 || {
  echo "ERROR: 'import k9_aif_abb' failed." >&2
  echo "  Run: pip install -r requirements.txt" >&2
  exit 1
}

python3 -c "$PROJECT_IMPORT_CHECK" >/dev/null 2>&1 || {
  echo "ERROR: project-local imports failed ({{ project_import_label }})." >&2
  echo "  Run ./setup.sh --verify for details." >&2
  exit 1
}

python3 "$SCRIPT_DIR/main.py" "$@"
