# SPDX-License-Identifier: Apache-2.0
# Generated by k9x_studio on {{ timestamp }}
# Agent YAML for {{ agent.name }}
{% if fw_adapter %}
# Built as {{ fw_agent_as }} by K9-AIF's {{ fw_adapter }} from this file (see runtimes/). There is no Python
# agent class: edit role, goal, instructions and tools here. K9-AIF governs every turn, tool call and reply.
{% elif step_agent %}
# An OpenAI agent, run by its squad as one step (K9OpenAIAgent, squad_agents/{{ agent.name | to_snake }}.py). The squad's
# flow sets the order; this agent never chooses what runs next. Edit role, goal, instructions and tools here.
{% endif %}

name: {{ agent.name }}
{% if step_agent %}
class: {{ agent.name }}
module: squad_agents.{{ agent.name | to_snake }}
{% elif not fw_adapter %}
class: {{ agent.name }}
module: agents.src.{{ agent.name | to_snake }}
{% endif %}

description: >
  {{ agent.description if agent.description else agent.name + ' — update with domain-specific description.' }}

pattern: {{ agent.pattern | default('reasoning') }}
model: {{ agent.model | default('general') }}

role: >
  You are a specialist agent responsible for {{ agent.name | lower | replace('agent', '') | trim }} tasks
{% if domain %}  within the {{ domain }} domain.
{% endif %}
goal: >
  Execute {{ agent.name | lower | replace('agent', '') | trim }} accurately and return a structured result.

{% if fw_adapter or step_agent %}
instructions:
  - Do only the part of the request this agent is responsible for
  - Use only what your tools return; never guess a value
  - Answer in plain, short sentences

tools: []                      # names of ToolCapability entries in runtimes/tools.py
{% if step_agent %}handoffs: []                   # always empty: the squad's flow decides what runs next
{% endif %}{% else %}
instructions:
  - Analyse the input payload carefully
  - Always include a confidence score in your output
  - Return a structured result matching the output_schema

output_schema:
  agent: string
  output: string
  confidence: float (0.0–1.0)

tools: []
{% endif %}{% if agent.type == 'K9ValidationLoopAgent' %}
max_iterations: 5
confidence_threshold: 0.8
finalize_on_max_iterations: true
{% endif %}

{% if not fw_adapter and not step_agent %}
governance:
  pre_process: false
  post_process: false
{% endif %}
# 4Ds — AI Fluency design decisions (Anthropic 4Ds Framework)
delegation:
{% if agent.type == 'K9ValidationLoopAgent' %}
  interaction_mode: augmentation
{% elif agent.type == 'K9PlanningLoopAgent' %}
  interaction_mode: agency
{% else %}
  interaction_mode: automation
{% endif %}
  ai_tasks:
    - {{ agent.name | lower | replace('agent', '') | trim }}
  human_tasks:
    - override and exception handling

discernment:
{% if agent.type == 'K9ValidationLoopAgent' or agent.type == 'K9PlanningLoopAgent' %}
  confidence_threshold: 0.8
  max_iterations: 5
  escalate_on_low_confidence: true
{% else %}
  confidence_threshold: 0.7
  max_iterations: 1
  escalate_on_low_confidence: false
{% endif %}

diligence:
  audit_trail: true
  requires_governance: false
  human_verification: not_required
